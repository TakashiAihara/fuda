      "policies": {},
      "checkConstraints": {
        "sections_kind_check": {
          "name": "sections_kind_check",
          "value": "\"sections\".\"kind\" in ('report', 'notice', 'question', 'request')"
        },
        "sections_reply_form_check": {
          "name": "sections_reply_form_check",
          "value": "\"sections\".\"reply_form\" is null or \"sections\".\"reply_form\" in ('free_text', 'choice', 'approval', 'external_tool', 'pickup')"
        },
        "sections_state_check": {
          "name": "sections_state_check",
          "value": "\n        \"sections\".\"state\" is null\n        or (\"sections\".\"reply_form\" = 'pickup' and \"sections\".\"state\" in ('not_started', 'in_progress', 'done'))\n        or (\"sections\".\"reply_form\" <> 'pickup' and \"sections\".\"state\" in ('unanswered', 'deferred', 'answered'))\n      "
        },
        "sections_state_matches_reply_form_check": {
          "name": "sections_state_matches_reply_form_check",
          "value": "(\"sections\".\"reply_form\" is null) = (\"sections\".\"state\" is null)"
        },
        "sections_unanswered_since_check": {
          "name": "sections_unanswered_since_check",
          "value": "\"sections\".\"state\" <> 'unanswered' or \"sections\".\"unanswered_since\" is not null"
        }
      },
