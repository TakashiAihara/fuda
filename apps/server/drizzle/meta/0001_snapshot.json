  "views": {
    "public.item_list": {
      "columns": {
        "id": {
          "name": "id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "summary": {
          "name": "summary",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "sender": {
          "name": "sender",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "attribution": {
          "name": "attribution",
          "type": "jsonb",
          "primaryKey": false,
          "notNull": true
        },
        "created_at": {
          "name": "created_at",
          "type": "timestamp with time zone",
          "primaryKey": false,
          "notNull": true
        },
        "read_at": {
          "name": "read_at",
          "type": "timestamp with time zone",
          "primaryKey": false,
          "notNull": false
        },
        "closed_at": {
          "name": "closed_at",
          "type": "timestamp with time zone",
          "primaryKey": false,
          "notNull": false
        },
        "oldest_unanswered_at": {
          "name": "oldest_unanswered_at",
          "type": "timestamp with time zone",
          "primaryKey": false,
          "notNull": false
        },
        "unanswered_count": {
          "name": "unanswered_count",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "deferred_count": {
          "name": "deferred_count",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "open_request_count": {
          "name": "open_request_count",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "section_count": {
          "name": "section_count",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n  select\n    i.id,\n    i.summary,\n    i.sender,\n    i.attribution,\n    i.created_at,\n    i.read_at,\n    i.closed_at,\n    min(s.unanswered_since) filter (where s.state = 'unanswered') as oldest_unanswered_at,\n    count(s.id) filter (where s.state = 'unanswered')::int as unanswered_count,\n    count(s.id) filter (where s.state = 'deferred')::int as deferred_count,\n    count(s.id) filter (where s.state in ('not_started', 'in_progress'))::int as open_request_count,\n    count(s.id)::int as section_count\n  from items i\n  left join sections s on s.item_id = i.id\n  group by i.id\n",
      "name": "item_list",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
