# The only value with no default. Everything else works out of the box.
FUDA_DATABASE_URL=postgres://fuda:fuda@localhost:5432/fuda

# FUDA_PORT=8787
# FUDA_BASE_URL=http://localhost:8787

# Stamped as the sender on anything the browser sends, since a sender is
# required on everything written and the person does not type their own name.
# FUDA_PERSON_IDENTITY=person

# Only for `bun run test:integration` and `bun run test:e2e`. Both empty the
# database, so they refuse to run against FUDA_DATABASE_URL and need somewhere
# disposable.
# FUDA_TEST_DATABASE_URL=postgres://fuda:fuda@localhost:5432/fuda_test
